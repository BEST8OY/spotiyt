/* SpotiYT Termux-Friendly Responsive Stylesheet */

Screen {
    background: #121212;
    color: #e0e0e0;
    overflow-y: auto;
}

Header {
    dock: top;
    height: 1;
    background: #181818;
    color: #1DB954;
    text-style: bold;
    border-bottom: solid #1DB954;
}

Footer {
    dock: bottom;
    height: 1;
    background: #181818;
    color: #888888;
}

/* Tabs */
TabbedContent {
    height: 1fr;
}

Tabs {
    background: #141414;
    height: 3;
    border-bottom: solid #282828;
    padding: 0 1;
}

Tabs:focus {
    border-bottom: solid #1DB954;
}

Tab {
    padding: 0 2;
    color: #aaaaaa;
    background: #1e1e1e;
    text-style: bold;
    border-top: round #2e2e2e;
    border-left: round #2e2e2e;
    border-right: round #2e2e2e;
    margin-right: 1;
    min-width: 6;
}

Tab:hover {
    color: #ffffff;
    background: #2a2a2a;
}

Tab:focus {
    color: #ffffff;
    background: #333333;
}

Tab.-active {
    color: #000000;
    background: #1DB954;
    text-style: bold;
    border-top: round #1ed760;
    border-left: round #1ed760;
    border-right: round #1ed760;
}

Tab.-active:focus {
    color: #000000;
    background: #1ed760;
}

Tabs:focus Tab.-active {
    color: #000000;
    background: #1DB954;
}

Underline {
    display: none;
}

TabPane {
    padding: 0 1;
    height: 1fr;
    overflow-y: auto;
}

.sync-options-bar {
    height: auto;
    background: #1a1a1a;
    border: round #2a2a2a;
    padding: 0 1;
    margin-bottom: 1;
}

/* Dashboard Styles */
.stats-container {
    height: auto;
    margin-bottom: 1;
    layout: horizontal;
}

.stat-card {
    height: 3;
    width: 1fr;
    min-width: 8;
    background: #1e1e1e;
    border: round #333333;
    padding: 0 1;
    margin-right: 1;
    align: center middle;
}

.stat-card:last-of-type {
    margin-right: 0;
}

.stat-title {
    color: #888888;
    text-style: bold;
    text-align: center;
}

.stat-value {
    color: #00d2ff;
    text-style: bold;
    text-align: center;
}

.stat-value.green {
    color: #1DB954;
}

.stat-value.red {
    color: #ff4d4d;
}

.stat-value.yellow {
    color: #f59e0b;
}

.table-container {
    height: 1fr;
    min-height: 8;
    background: #181818;
    border: round #2a2a2a;
    padding: 0;
    margin-bottom: 1;
    overflow-y: auto;
}

DataTable {
    height: 1fr;
    background: #181818;
}

DataTable > .datatable--header {
    background: #242424;
    color: #1DB954;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1DB954;
    color: #000000;
    text-style: bold;
}

/* Responsive Button Grids & Toolbars */
.toolbar {
    height: auto;
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    margin-top: 1;
    margin-bottom: 1;
}

.toolbar-3col {
    height: auto;
    layout: grid;
    grid-size: 3;
    grid-gutter: 1;
    margin-top: 1;
    margin-bottom: 1;
}

Button {
    width: 100%;
    min-width: 6;
    height: 3;
    margin: 0;
    border: none;
    text-style: bold;
    text-align: center;
}

Button:focus {
    border: tall #00d2ff;
}

.btn-primary {
    background: #1DB954;
    color: #000000;
}

.btn-primary:hover {
    background: #1ed760;
}

.btn-danger {
    background: #FF0000;
    color: #ffffff;
}

.btn-danger:hover {
    background: #ff3333;
}

.btn-secondary {
    background: #2a2a2a;
    color: #e0e0e0;
}

.btn-secondary:hover {
    background: #3a3a3a;
}

.btn-info {
    background: #0284c7;
    color: #ffffff;
}

.btn-info:hover {
    background: #0369a1;
}

.btn-warning {
    background: #d97706;
    color: #000000;
}

.btn-warning:hover {
    background: #b45309;
}

/* Responsive Form Styles */
.form-panel {
    background: #1e1e1e;
    border: round #333333;
    padding: 1;
    height: auto;
    margin-bottom: 1;
    overflow-y: auto;
}

.form-row {
    height: auto;
    layout: vertical;
    margin-bottom: 1;
}

.form-label {
    width: 100%;
    color: #1DB954;
    text-style: bold;
    margin-bottom: 0;
    padding: 0;
}

Input {
    width: 100%;
    height: 3;
    border: round #444444;
    background: #121212;
    color: #ffffff;
    padding: 0 1;
}

Input:focus {
    border: round #1DB954;
}

Select {
    width: 100%;
    height: 3;
    border: round #444444;
    background: #121212;
    color: #ffffff;
}

Select:focus {
    border: round #1DB954;
}

Switch {
    margin-top: 0;
    margin-bottom: 0;
    min-width: 6;
}

Switch.-on {
    background: #1DB954;
}

.switch-group {
    height: auto;
    layout: vertical;
    margin-bottom: 1;
}

.switch-row {
    height: auto;
    min-height: 3;
    layout: horizontal;
    align-vertical: middle;
    margin-bottom: 1;
}

.switch-label {
    color: #e0e0e0;
    margin-left: 1;
    width: 1fr;
}

/* Large & Generous Log / Output Panel */
.output-panel {
    background: #181818;
    border: round #2a2a2a;
    height: 1fr;
    min-height: 16;
    padding: 1;
    margin-top: 1;
    margin-bottom: 1;
}

RichLog {
    height: 1fr;
    min-height: 12;
    background: #0d0d0d;
    border: round #222222;
    color: #e0e0e0;
    padding: 0 1;
}

ProgressBar {
    height: auto;
    min-height: 2;
    margin-bottom: 1;
    padding: 0;
}

ProgressBar > Bar {
    width: 1fr;
    color: #1DB954;
    background: #242424;
}

ProgressBar > .bar--bar {
    color: #242424;
    background: transparent;
}

ProgressBar > .bar--complete {
    color: #1DB954;
    background: transparent;
}

ProgressBar > PercentageStatus {
    color: #00d2ff;
    text-style: bold;
    margin-left: 1;
}

ProgressBar > ETAStatus {
    color: #888888;
    margin-left: 1;
}

/* Auth / Settings Card */
.auth-grid {
    layout: vertical;
    height: auto;
    margin-bottom: 1;
}

.auth-card {
    background: #1e1e1e;
    border: round #333333;
    padding: 1;
    height: auto;
    margin-bottom: 1;
}

.auth-title {
    color: #1DB954;
    text-style: bold;
    margin-bottom: 0;
}

.auth-desc {
    color: #999999;
    margin-bottom: 1;
}

.guide-box {
    background: #181818;
    border: round #2a2a2a;
    padding: 1;
    height: auto;
    min-height: 8;
    color: #cccccc;
    overflow-y: auto;
}

/* Responsive Modal Dialogs */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

.modal-dialog {
    width: 95%;
    max-width: 58;
    height: auto;
    max-height: 90%;
    background: #1e1e1e;
    border: round #1DB954;
    padding: 1;
    overflow-y: auto;
}

.modal-title {
    color: #1DB954;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

.modal-body {
    color: #e0e0e0;
    margin-bottom: 1;
    text-align: center;
}

.modal-buttons {
    height: auto;
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    margin-top: 1;
}

.modal-buttons Button {
    width: 100%;
}

.modal-large {
    width: 96%;
    max-width: 78;
    height: 90%;
    max-height: 32;
    background: #1e1e1e;
    border: round #00d2ff;
    padding: 1;
    overflow-y: auto;
}
