/* SpotiYT - Fully Aligned with Textual Source Architecture */

* {
    scrollbar-color: #1DB954 #242424;
    scrollbar-color-hover: #1ed760 #333333;
    scrollbar-color-active: #00d2ff #444444;
}

Screen {
    background: #121212;
    color: #e0e0e0;
    overflow: hidden hidden;
    scrollbar-size-horizontal: 0;
}

/* ==================== Header ==================== */

Header {
    dock: top;
    height: 1;
    background: #181818;
    color: #1DB954;
    text-style: bold;
    border: none;
    overflow: hidden hidden;
    scrollbar-size-horizontal: 0;
}

HeaderTitle {
    color: #1DB954;
    text-style: bold;
}

HeaderClock {
    color: #00d2ff;
    text-style: bold;
}

HeaderIcon {
    color: #1DB954;
}

/* ==================== Footer ==================== */

Footer {
    dock: bottom;
    height: 1;
    background: #181818;
    color: #888888;
    overflow: hidden hidden;
    scrollbar-size-horizontal: 0;
    scrollbar-size-vertical: 0;
}

/* ==================== Navigation Tabs ==================== */

TabbedContent {
    height: 1fr;
    overflow: hidden hidden;
    scrollbar-size-horizontal: 0;
}

ContentSwitcher {
    height: 1fr;
    overflow: hidden hidden;
    scrollbar-size-horizontal: 0;
}

Tabs {
    width: 100%;
    height: 2;
    background: #141414;
    padding: 0;
    scrollbar-size-horizontal: 0;
}

Tabs > #tabs-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-size-horizontal: 0;
    scrollbar-size-vertical: 0;
}

Tabs > #tabs-scroll > #tabs-list-bar,
Tabs > #tabs-scroll > #tabs-list-bar > #tabs-list {
    width: auto;
    height: auto;
    min-width: 100%;
    overflow: hidden hidden;
}

Tab {
    width: auto;
    height: 1;
    padding: 0 1;
    text-align: center;
    color: #888888;
    background: transparent;
    text-style: bold;
}

Tab:hover {
    color: #ffffff;
    background: #1f1f1f;
}

Tab:focus {
    color: #ffffff;
    background: #242424;
}

Tab.-active {
    color: #1DB954;
    text-style: bold;
}

Tabs:focus Tab.-active {
    color: #000000;
    background: #1DB954;
    text-style: bold;
}

Underline {
    width: 1fr;
    height: 1;
}

Underline > .underline--bar {
    color: #1DB954;
    background: #282828;
}

TabPane {
    padding: 0 1;
    height: 1fr;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size-horizontal: 0;
}

/* ==================== DataTable ==================== */

.table-container {
    height: 1fr;
    min-height: 8;
    background: #181818;
    border: round #2a2a2a;
    padding: 0;
    margin-bottom: 1;
    overflow: hidden hidden;
}

DataTable {
    height: 1fr;
    background: #181818;
    scrollbar-size-horizontal: 1;
    scrollbar-size-vertical: 1;
}

DataTable > .datatable--header {
    background: #242424;
    color: #1DB954;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1DB954;
    color: #000000;
    text-style: bold;
}

DataTable > .datatable--hover {
    background: #202020;
}

/* ==================== Buttons & Variants ==================== */

.toolbar {
    height: auto;
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    margin-top: 1;
    margin-bottom: 1;
}

Button {
    width: 100%;
    min-width: 6;
    height: 3;
    margin: 0;
    border: none;
    text-style: bold;
    text-align: center;
}

Button:focus {
    border: tall #00d2ff;
}

Button.-primary {
    background: #1DB954;
    color: #000000;
}

Button.-primary:hover {
    background: #1ed760;
}

Button.-error {
    background: #FF0000;
    color: #ffffff;
}

Button.-error:hover {
    background: #ff3333;
}

Button.-default {
    background: #2a2a2a;
    color: #e0e0e0;
}

Button.-default:hover {
    background: #3a3a3a;
}

Button.-warning {
    background: #d97706;
    color: #000000;
}

Button.-warning:hover {
    background: #b45309;
}

/* ==================== Inputs & Select ==================== */

.form-section-title {
    color: #1DB954;
    text-style: bold;
    margin-bottom: 1;
}

.form-panel {
    background: #1e1e1e;
    border: round #333333;
    padding: 1;
    height: auto;
    margin-bottom: 1;
    overflow: hidden hidden;
}

.form-row {
    height: auto;
    layout: vertical;
    margin-bottom: 1;
}

.form-label {
    width: 100%;
    color: #1DB954;
    text-style: bold;
    margin-bottom: 0;
    padding: 0;
}

Input {
    width: 100%;
    height: 3;
    border: round #444444;
    background: #121212;
    color: #ffffff;
    padding: 0 1;
}

Input:focus {
    border: round #1DB954;
}

Select {
    width: 100%;
    height: auto;
}

SelectCurrent {
    background: #121212;
    border: round #444444;
    color: #ffffff;
    height: 3;
    padding: 0 1;
}

SelectCurrent:focus {
    border: round #1DB954;
}

SelectCurrent.-has-value #label {
    color: #1DB954;
    text-style: bold;
}

SelectCurrent #label {
    color: #888888;
}

SelectOverlay {
    background: #1a1a1a;
    border: round #1DB954;
    color: #ffffff;
}

SelectOverlay OptionList {
    background: #1a1a1a;
    color: #e0e0e0;
}

/* ==================== Switch ==================== */

Switch {
    margin: 0;
    min-width: 6;
}

Switch .switch--slider {
    color: #555555;
    background: #222222;
}

Switch.-on .switch--slider {
    color: #1DB954;
}

.sync-options-bar {
    height: auto;
    background: #1a1a1a;
    border: round #2a2a2a;
    padding: 0 1;
    margin-bottom: 1;
}

.switch-group {
    height: auto;
    layout: vertical;
    margin-bottom: 1;
}

.switch-row {
    height: auto;
    min-height: 3;
    layout: horizontal;
    align-vertical: middle;
    margin-bottom: 1;
}

.switch-label {
    color: #e0e0e0;
    margin-left: 1;
    width: 1fr;
}

/* ==================== Output Panels & RichLog ==================== */

.output-panel {
    background: #181818;
    border: round #2a2a2a;
    height: auto;
    min-height: 14;
    padding: 1;
    margin-top: 0;
    margin-bottom: 1;
    overflow: hidden hidden;
}

RichLog {
    height: auto;
    min-height: 12;
    max-height: 25;
    background: #0d0d0d;
    border: round #222222;
    color: #e0e0e0;
    padding: 0 1;
    overflow: auto auto;
    scrollbar-size-horizontal: 1;
    scrollbar-size-vertical: 1;
}

ProgressBar {
    height: auto;
    min-height: 2;
    margin-bottom: 1;
    padding: 0;
}

ProgressBar > Bar {
    width: 1fr;
    color: #1DB954;
    background: #242424;
}

ProgressBar > .bar--bar {
    color: #242424;
    background: transparent;
}

ProgressBar > .bar--complete {
    color: #1DB954;
    background: transparent;
}

ProgressBar > PercentageStatus {
    color: #00d2ff;
    text-style: bold;
    margin-left: 1;
}

ProgressBar > ETAStatus {
    color: #888888;
    margin-left: 1;
}

/* ==================== Auth & Settings Cards ==================== */

.auth-grid {
    layout: vertical;
    height: auto;
    margin-bottom: 1;
}

.auth-card {
    background: #1e1e1e;
    border: round #333333;
    padding: 1;
    height: auto;
    margin-bottom: 1;
    overflow: hidden hidden;
}

.auth-title {
    color: #1DB954;
    text-style: bold;
    margin-bottom: 0;
}

.auth-desc {
    color: #999999;
    margin-bottom: 1;
}

.guide-box {
    background: #181818;
    border: round #2a2a2a;
    padding: 1;
    height: auto;
    min-height: 8;
    color: #cccccc;
    overflow: hidden hidden;
}

/* ==================== Modal Screens & Stats ==================== */

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.7);
}

.modal-dialog {
    width: 95%;
    max-width: 58;
    height: auto;
    max-height: 90%;
    background: #1e1e1e;
    border: round #1DB954;
    padding: 1;
    overflow: auto auto;
}

.modal-title {
    color: #1DB954;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

.modal-body {
    color: #e0e0e0;
    margin-bottom: 1;
    text-align: center;
}

.modal-buttons {
    height: auto;
    layout: grid;
    grid-size: 2;
    grid-gutter: 1;
    margin-top: 1;
}

.modal-large {
    width: 96%;
    max-width: 78;
    height: 90%;
    max-height: 32;
    background: #1e1e1e;
    border: round #00d2ff;
    padding: 1;
    overflow: auto auto;
}

.modal-sync {
    width: 96%;
    max-width: 80;
    height: 85%;
    max-height: 28;
    background: #181818;
    border: round #1DB954;
    padding: 1;
    overflow: auto auto;
}

.sync-modal-subtitle {
    color: #00d2ff;
    text-align: center;
    margin-bottom: 1;
    text-style: bold;
}

#sync-modal-log {
    height: 1fr;
    min-height: 8;
    background: #0d0d0d;
    border: round #222222;
    margin-top: 1;
    margin-bottom: 1;
    overflow: auto auto;
}

.stats-container {
    height: auto;
    margin-bottom: 1;
    layout: horizontal;
}

.stat-card {
    height: 3;
    width: 1fr;
    min-width: 8;
    background: #1e1e1e;
    border: round #333333;
    padding: 0 1;
    margin-right: 1;
    align: center middle;
}

.stat-card:last-of-type {
    margin-right: 0;
}

.stat-title {
    color: #888888;
    text-style: bold;
    text-align: center;
}

.stat-value {
    color: #00d2ff;
    text-style: bold;
    text-align: center;
}

.stat-value.green {
    color: #1DB954;
}

.stat-value.red {
    color: #ff4d4d;
}

.stat-value.yellow {
    color: #f59e0b;
}
